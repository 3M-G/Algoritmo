Algoritmo "Segundo Algoritmo"
Var
   nome: caractere
   idade: caractere


Inicio
       escreval ("Qual é seu nome?")
       leia (nome)
       escreval ("Muito prazer ", nome, " , E qual seria sua idade?")
       leia (idade)
       escreva ("Então você se chama ", nome, " e tem ", idade, " anos muito obrigado pelas informações!" )


Fimalgoritmo