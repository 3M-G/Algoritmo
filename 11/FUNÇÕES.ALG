Algoritmo "FUNÇÕES"
Var
   v1, v2, s: inteiro
   
funcao soma(x, y: inteiro): inteiro
inicio
       retorne x + y
fimfuncao

Inicio
      escreva ("Digite um numero: ")
      leia (v1)
      escreva ("Digite outro numero: ")
      leia (v2)
      s <- soma(v1, v2)
      escreva ("A soma entre ", v1," e ", v2," é igual: ", s)
Fimalgoritmo