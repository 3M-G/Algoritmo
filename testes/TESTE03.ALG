algoritmo "teste2"
var
   a, alt, l, t: real

inicio
   escreva ("Informe a largura da parede: ")
   leia (l)
   escreva ("informe a altura da parede: ")
   leia (a)
   alt <- l * a
   t <- alt / 2
   escreva (" para pintar a area de ", alt, " metros quadrados, você precisara de ", t, " litros de tintas")
   ")
fimalgoritmo
