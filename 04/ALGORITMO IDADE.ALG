algoritmo "Quarto Algoritmo"
var
   ano_atual, ano_nasci, idade: inteiro
inicio
      escreva ("Em que ano estamos ? ")
      leia (ano_atual)
      escreva ("Em que ano nasci? ")
      leia (ano_nasci)
      idade <- ano_atual - ano_nasci
      escreva ("Minha idade é ", idade, " Anos")
fimalgoritmo
